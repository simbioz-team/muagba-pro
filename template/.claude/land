#!/usr/bin/env bash
# Вливание прошедших ревью веток в develop — без подтверждения человека
# (разрешение `Bash(./.claude/land *)` в .claude/settings.json).
#   ./.claude/land <ветка фичи> <ветка>...   — влить зелёные --ff-only
#   ./.claude/land <ветка фичи> <ветка>... --dry-run
#
# Обёртка над task_pairs.py land --require-green установленного плагина:
# вливается только ветка, зелёная по проверкам проекта, — `.claude/merge-check
# <коммит>`, если проект его завёл (например, ответ CI), иначе гейт сдачи
# (дерево ветки прошло check.sh при SubagentStop). Только --ff-only, без
# rebase; в main, master и основную ветку origin — отказ: это выпуск, его
# делает человек. Пуш влитого — не здесь.
set -uo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# Плагин ищется по списку установленных, как в claude-night: сначала
# установка этого проекта, затем пользовательская.
PLUGIN_SCRIPTS=$(python3 - "$ROOT" <<'PY'
import json, os, subprocess, sys
root = sys.argv[1]
r = subprocess.run(["git", "-C", root, "rev-parse", "--path-format=absolute", "--git-common-dir"],
                   capture_output=True, text=True)
main = os.path.dirname(r.stdout.strip()) if r.returncode == 0 else root
try:
    d = json.load(open(os.path.expanduser("~/.claude/plugins/installed_plugins.json")))
except (OSError, ValueError):
    sys.exit(0)
es = d.get("plugins", {}).get("muagba-base@muagba-pro", [])
es = sorted(es, key=lambda e: (e.get("projectPath") not in (root, main), e.get("scope") != "user"))
for e in es:
    p = os.path.join(e.get("installPath", ""), "scripts")
    if os.path.isfile(os.path.join(p, "task_pairs.py")):
        print(p)
        break
PY
)
[ -n "$PLUGIN_SCRIPTS" ] || { echo "land: не найден установленный плагин muagba-base (≥ 0.23.17)." >&2; exit 1; }
exec python3 "$PLUGIN_SCRIPTS/task_pairs.py" land "$@" --require-green --root "$PWD"
