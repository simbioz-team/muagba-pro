# --- Агентское окружение ---
.claude/worktrees/          # рабочие деревья параллельных агентов
.claude/settings.local.json # личные права, не команда
.claude/logs/               # журнал запусков агентов
CLAUDE.local.md             # личные инструкции

# --- Секреты ---
.env
.env.*
!.env.example

# --- Проверки базы ---
__pycache__/                # .claude/check-frames.py оставляет его в любом проекте
*.pyc

# --- Дополни под стек проекта ---
