# --- Агентское окружение ---
# Комментарий в .gitignore работает только с начала строки: приписанный
# в конец, он становится частью шаблона, и строка перестаёт что-либо
# игнорировать. Поэтому пояснения здесь стоят над строками, а не рядом.

# рабочие деревья параллельных агентов
.claude/worktrees/
# личные права, не команда
.claude/settings.local.json
# журнал запусков агентов
.claude/logs/
# личные инструкции
CLAUDE.local.md

# --- Секреты ---
.env
.env.*
!.env.example

# --- Проверки базы ---
# .claude/check-frames.py оставляет его в любом проекте
__pycache__/
*.pyc

# --- Дополни под стек проекта ---
