#!/usr/bin/env bash
# Ночной прогон (ADR-0016 базы muagba-pro). Запускает человек:
#   .claude/claude-night [аргументы claude, например --resume <сессия>]
#
# 1. Подготовка обязательна. Нет утверждённых на сегодня разрешений
#    (.claude/night/approved.json с сегодняшней датой) — сначала
#    запускается подготовка, /muagba-base:night-prep, в обычном режиме,
#    с человеком.
# 2. Утверждённое показывается, ночь стартует только после «y».
# 3. Ночь — режим auto Claude Code: каждое действие, которое днём спросило
#    бы человека, проверяет контролёр по правилам из .claude/night/settings.json
#    и утверждённым на сегодня. Правила контролёра Claude Code читает только
#    из файла, переданного при запуске, — проект сам себе их не расширит.
#    Что всё же дошло бы до человека, хук базы откладывает в
#    .claude/logs/morning.md.
#
# Из сессии Claude ночь запускает команда /muagba-base:night: подготовку и
# подтверждение она проводит в самой сессии, а лаунчер зовёт с
#   --yes  подтверждение уже дано (без утверждённого на сегодня — отказ:
#          подготовка требует человека и терминала);
#   --bg   ночь — фоновой сессией Claude (claude --bg): терминал не нужен,
#          смотреть — claude attach <id>.
#
# Каталог запуска. С --resume <сессия> ночь идёт в каталоге этой сессии —
# Claude продолжает сессию только оттуда, где она начата, а лаунчер может
# лежать в рабочем дереве. Так у narta ночь не началась вовсе: лаунчер ушёл в
# дерево координатора, сессия жила в основном checkout, --resume не нашёл её,
# и сессию подняли обычным claude, без ночного режима. Без --resume — текущий
# каталог.
set -uo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
BASE="$ROOT/.claude/night/settings.json"
APPROVED="$ROOT/.claude/night/approved.json"
CLAUDE_BIN="${CLAUDE_BIN:-claude}"
TODAY=$(date +%F)

# Свои флаги лаунчера; остальное уходит claude как есть.
YES=""; BG=""; ARGS=()
for a in "$@"; do
  case "$a" in
    --yes) YES=1 ;;
    --bg) BG=1 ;;
    *) ARGS+=("$a") ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

# Каталог сессии из --resume: первая запись стенограммы с полем cwd.
RUN_DIR="$PWD"
SESSION=""
prev=""
for a in "$@"; do
  case "$prev" in --resume|-r) SESSION="$a" ;; esac
  case "$a" in --resume=*) SESSION="${a#--resume=}" ;; esac
  prev="$a"
done
if [ -n "$SESSION" ]; then
  FOUND=$(python3 - "$SESSION" <<'PY'
import glob, json, os, sys
for f in glob.glob(os.path.expanduser(f"~/.claude/projects/*/{sys.argv[1]}.jsonl")):
    for line in open(f, encoding="utf-8", errors="replace"):
        try:
            cwd = json.loads(line).get("cwd")
        except ValueError:
            continue
        if cwd:
            print(cwd)
            sys.exit(0)
PY
)
  if [ -n "$FOUND" ] && [ -d "$FOUND" ]; then
    RUN_DIR="$FOUND"
  else
    echo "claude-night: сессия $SESSION не найдена — ночь не начинается (проверьте id: claude --resume покажет список)." >&2
    exit 1
  fi
fi
echo "claude-night: ночь пойдёт в $RUN_DIR"

approved_today() {
  python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.exit(0 if d.get("date")==sys.argv[2] else 1)' \
    "$APPROVED" "$TODAY" 2>/dev/null
}

[ -f "$BASE" ] || { echo "claude-night: нет $BASE — ночной режим не настроен (вопрос В9.11)." >&2; exit 1; }

if ! approved_today && [ -n "$YES" ]; then
  echo "claude-night: разрешения на сегодня не утверждены — сначала подготовка (/muagba-base:night проводит её в сессии)." >&2
  exit 1
fi
if ! approved_today; then
  cat <<MSG
claude-night: подготовки к ночи сегодня не было — сначала она, в обычном режиме, с вами.
  Сейчас откроется сессия подготовки. Когда утвердите разрешения, закройте её
  командой /exit — ночь стартует сама, из этого же окна. Лаунчер второй раз
  запускать не нужно.
MSG
  # Ctrl+C в сессии подготовки не должен убивать лаунчер: после неё — ночь.
  trap 'true' INT
  (cd "$RUN_DIR" && MUAGBA_NIGHT_APPROVED="$APPROVED" "$CLAUDE_BIN" "/muagba-base:night-prep")
  trap - INT
  approved_today || { echo "claude-night: разрешения на сегодня не утверждены — ночь не начинается." >&2; exit 1; }
  echo "claude-night: подготовка закрыта, утверждённое на сегодня есть."
fi

# Правила ночи: базовые — из установленного плагина (обновляются с ним),
# плюс правила проекта и утверждённое на сегодня. Плагин ищется по списку
# установленных: сначала установка этого проекта, затем пользовательская.
PLUGIN_SCRIPTS=$(python3 - "$ROOT" <<'PY'
import json, os, subprocess, sys
root = sys.argv[1]
r = subprocess.run(["git", "-C", root, "rev-parse", "--path-format=absolute", "--git-common-dir"],
                   capture_output=True, text=True)
main = os.path.dirname(r.stdout.strip()) if r.returncode == 0 else root
try:
    d = json.load(open(os.path.expanduser("~/.claude/plugins/installed_plugins.json")))
except (OSError, ValueError):
    sys.exit(0)
es = d.get("plugins", {}).get("muagba-base@muagba-pro", [])
es = sorted(es, key=lambda e: (e.get("projectPath") not in (root, main), e.get("scope") != "user"))
for e in es:
    p = os.path.join(e.get("installPath", ""), "scripts")
    if os.path.isfile(os.path.join(p, "night_rules.py")):
        print(p)
        break
PY
)
[ -n "$PLUGIN_SCRIPTS" ] || { echo "claude-night: не найден установленный плагин muagba-base (≥ 0.20.3) — базовые ночные правила взять неоткуда." >&2; exit 1; }
MERGED=$(mktemp "${TMPDIR:-/tmp}/claude-night.XXXXXX.json")
MUAGBA_NIGHT_START=$(date -Is)
python3 "$PLUGIN_SCRIPTS/night_rules.py" "$BASE" "$APPROVED" "$MERGED" "$MUAGBA_NIGHT_START" || exit 1

if [ -z "$YES" ]; then
  read -r -p "Запустить ночь с этими разрешениями? [y/N] " ANSWER
  [ "$ANSWER" = y ] || [ "$ANSWER" = Y ] || { echo "Отменено."; exit 1; }
fi

export MUAGBA_MODE=night
export MUAGBA_NIGHT_START
cd "$RUN_DIR" || exit 1
if [ -n "$BG" ]; then
  # Фоновая сессия начинает с поручения, иначе она просто ждала бы ввода.
  PROMPT="Ночь началась (ночной режим, ADR-0016). Работай по плану из ${APPROVED}: задачи по порядку, утверждённые разрешения. Упёрся в человека — запиши и бери следующую независимую задачу. Утром — /muagba-base:night-report."
  "$CLAUDE_BIN" --bg --permission-mode auto --settings "$MERGED" "$@" "$PROMPT" || exit 1
  echo "claude-night: ночь запущена в фоне. Смотреть: claude agents, claude attach <id>. Дневную сессию координатора закройте — иначе их будет две."
  exit 0
fi
exec "$CLAUDE_BIN" --permission-mode auto --settings "$MERGED" "$@"
